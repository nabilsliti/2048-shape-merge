rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Players ─────────────────────────────────────────
    match /players/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollections (e.g. dailyChallenges)
      match /data/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ── Leaderboard ─────────────────────────────────────
    match /leaderboard/{entryId} {
      allow read: if true;

      function validLeaderboard() {
        let d = request.resource.data;
        return d.score is number
            && d.score >= 0
            && d.score <= 999999
            && d.displayName is string
            && d.displayName.size() <= 50
            && d.mergeCount is number
            && d.maxLevel is number;
      }

      // Rate limit: at most one update per 5 seconds.
      function notTooFrequent() {
        return !('timestamp' in resource.data)
            || request.time > resource.data.timestamp + duration.value(5, 's');
      }

      allow create: if isAuth() && request.auth.uid == entryId
        && validLeaderboard();
      allow update: if isAuth() && request.auth.uid == entryId
        && validLeaderboard()
        && notTooFrequent();
      allow delete: if isAuth() && request.auth.uid == entryId;
    }
  }
}
